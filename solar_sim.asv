function Q_solar = solar_sim(location, currentTime, phi, A_w)

% location: struct
%   ex:
%       location.longitude = -97.743; 
%       location.latitude = 30.2672; [deg]
%       location.altitude = 185; % [m]

% currentTime: ex - datetime(2026, 1, 30, 0, 0, 0);

% SIMULATION SETUP

% Window Parameters
phi = 180; % [deg] Angle of window East of North
A_w = 1; % [m^2] Area of window



% SIMULATION

dv = datevec(currentTime);

% Create the time struct
timeStruct.year = dv(1);
timeStruct.month = dv(2);
timeStruct.day = dv(3);
timeStruct.hour = dv(4);
timeStruct.min = dv(5);
timeStruct.sec = dv(6);
timeStruct.UTC = -6; % Central Time

% Get sun position
sun = sun_position(timeStruct, location);
sun.altitude = 90 - sun.zenith;

% Calculate direct normal irradiance (W/m^2 received from sun)
DNI = 0;
if sun.altitude > 0 % Only check when sun is above horizon
AM = 1/cos(deg2rad(sun.zenith));
DNI = 1353*(0.7^AM)^0.678;
end

% Calculate Q_solar
cos_theta = cos(deg2rad(sun.altitude))*cos(deg2rad(sun.azimuth-phi));
Q_solar = 0;
if cos_theta > 0
Q_solar = DNI*A_w*cos_theta;
end

% % Plot altitude vs azimuth
% figure;
% scatter(sunAzimuths, sunAltitudes, '.');
% xlabel('Sun Azimuth (degrees)');
% ylabel('Sun Altitude (degrees)');
% title('Sun Position Over Time');
% grid on;
% 
% % Plot direct normal irradiance values
% figure;
% plot(time/3600, DNIValues);
% xlabel('Time (hours)');
% ylabel('Direct Normal Irradiance (W/m^2)');
% title('Direct Normal Irradiance Over Time');
% grid on;
% 
% % Plot Q_solar on window
% figure;
% plot(time/3600, Q_solar_vals);
% xlabel('Time (hours)');
% ylabel('Solar Power on Window (W)');
% title('Solar Power on Window Over Time');
% grid on;

end